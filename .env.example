# Mẫu cấu hình - KHÔNG chứa key thật.
# Cách dùng: copy file này thành .env rồi điền key.
#   Copy-Item .env.example .env
# File .env đã nằm trong .gitignore nên sẽ không bị commit.
DEEPSEEK_API_KEY= key

# ---------------------------------------------------------------------------
# Tuỳ chọn - các giá trị dưới đây đã đúng mặc định, chỉ bỏ comment khi cần đổi.
# Biến đặt trong môi trường ($env:...) luôn được ưu tiên hơn file .env.
# ---------------------------------------------------------------------------
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=300
# DEEPSEEK_MAX_TOKENS=8000
# DEEPSEEK_TEMPERATURE=0.3
# MAX_UPLOAD_BYTES=20971520
# MAX_PDF_BYTES (tên cũ) vẫn được đọc nếu MAX_UPLOAD_BYTES chưa đặt.
# MAX_TEXT_CHARS=120000
# MAX_BATCH_FILES=10
# Chặn zip bomb cho .docx/.xlsx: dung lượng giải nén tối đa = bội số của giới hạn upload.
# MAX_ZIP_EXPANSION_RATIO=50
# Số ký tự / trang khi ước lượng "pages" cho .docx/.txt/.csv (.xlsx dùng số sheet).
# CHARS_PER_PAGE_ESTIMATE=3000
# --- Sinh nội dung dạy học (/process-document) ---
# Số câu hỏi mỗi kết quả (client gửi field `count`; 0 = dùng mặc định).
# DOCUMENT_MIN_QUESTIONS=1
# DOCUMENT_DEFAULT_QUESTIONS=10
# DOCUMENT_MAX_QUESTIONS=30
# Ngân sách ký tự cho ngữ cảnh cross-document của cả môn.
# MAX_SUBJECT_CONTEXT_CHARS=100000
# MAX_CROSS_DOCUMENT_CHARS=30000
# MIN_DOCUMENT_EXCERPT_CHARS=1200
# Số lần gọi bổ sung khi model trả thiếu câu; true = trả 502 nếu vẫn thiếu.
# QUESTION_TOPUP_ATTEMPTS=3
# STRICT_QUESTION_COUNT=true
# --- Đề luyện thi (/generate-exam) ---
# EXAM_TEMPERATURE=0.9
# EXAM_MAX_TOKENS=8000
# EXAM_MIN_QUESTIONS=1
# EXAM_MAX_QUESTIONS=30
# MAX_EXAM_CONTEXT_CHARS=16000
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HOST=127.0.0.1
# PORT=8000
