# Mẫu cấu hình - KHÔNG chứa key thật.
# Cách dùng: copy file này thành .env rồi điền key.
#   Copy-Item .env.example .env
# File .env đã nằm trong .gitignore nên sẽ không bị commit.
DEEPSEEK_API_KEY= key

# ---------------------------------------------------------------------------
# Tuỳ chọn - các giá trị dưới đây đã đúng mặc định, chỉ bỏ comment khi cần đổi.
# Biến đặt trong môi trường ($env:...) luôn được ưu tiên hơn file .env.
# ---------------------------------------------------------------------------
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=300
# DEEPSEEK_MAX_TOKENS=8000
# DEEPSEEK_TEMPERATURE=0.3
# JSON hỏng sau khi json-repair đã sửa -> gửi lại yêu cầu thêm bao nhiêu lần (mặc định 2).
# JSON_PARSE_RETRY_ATTEMPTS=2
# Giới hạn dung lượng 1 file upload (mặc định 104857600 = 100 MB).
# Phải >= giới hạn chọn file trên giao diện (70 MB) để UI và server khớp nhau.
# MAX_UPLOAD_BYTES=104857600
# MAX_PDF_BYTES (tên cũ) vẫn được đọc nếu MAX_UPLOAD_BYTES chưa đặt.
# MAX_TEXT_CHARS=120000
# MAX_BATCH_FILES=10
# Chặn zip bomb cho .docx/.xlsx: dung lượng giải nén tối đa = bội số của giới hạn upload.
# MAX_ZIP_EXPANSION_RATIO=50
# Số ký tự / trang khi ước lượng "pages" cho .docx/.txt/.csv (.xlsx dùng số sheet).
# CHARS_PER_PAGE_ESTIMATE=3000
# --- Sinh nội dung dạy học (/process-document) ---
# `mode=per_file` (mặc định): mỗi file là một phần tử kết quả và được phân tích
# độc lập, prompt chỉ chứa nội dung của đúng file đó (giới hạn bởi MAX_TEXT_CHARS).
# `mode=combined`: gộp toàn bộ tài liệu của môn vào một kết quả duy nhất.
# Số câu hỏi mỗi kết quả (client gửi field `count`; 0 = dùng mặc định).
# DOCUMENT_MIN_QUESTIONS=1
# DOCUMENT_DEFAULT_QUESTIONS=10
# DOCUMENT_MAX_QUESTIONS=30
# Ngân sách ký tự cho ngữ cảnh nhiều tài liệu — CHỈ dùng ở mode=combined.
# MAX_SUBJECT_CONTEXT_CHARS=100000
# MAX_CROSS_DOCUMENT_CHARS=30000
# MIN_DOCUMENT_EXCERPT_CHARS=1200
# Số lần gọi bổ sung khi model trả thiếu câu; true = trả 502 nếu vẫn thiếu.
# QUESTION_TOPUP_ATTEMPTS=3
# STRICT_QUESTION_COUNT=true
# --- Đề luyện thi (/generate-exam) ---
# EXAM_TEMPERATURE=0.9
# EXAM_MAX_TOKENS=8000
# EXAM_MIN_QUESTIONS=1
# EXAM_MAX_QUESTIONS=30
# MAX_EXAM_CONTEXT_CHARS=16000
# --- Giải thích khái niệm (/explain-concept) ---
# Nhiệt độ thấp hơn để phần giải thích bám sát tài liệu (mặc định 0.4).
# EXPLAIN_TEMPERATURE=0.4
# Giới hạn token cho 4 phần definition/erklaerung/zusammenhang/kritik (mặc định 4000).
# EXPLAIN_MAX_TOKENS=4000
# Ngân sách ký tự của `context` (nội dung tài liệu client gửi kèm) và tên khái niệm.
# MAX_CONCEPT_CONTEXT_CHARS=30000
# MAX_CONCEPT_NAME_CHARS=200
# --- Chia sách thành chương (/process-book) ---
# Số trang đầu sách được dò mục lục (Inhaltsverzeichnis / Table of contents) để
# tránh khớp nhầm "Inhalt" trong phần nội dung; tối đa bao nhiêu trang liền nhau
# thuộc một mục lục nhiều trang.
# BOOK_TOC_SEARCH_PAGES=40
# BOOK_TOC_MAX_PAGES=12
# Số trang in trên mục lục được phép lớn hơn số trang PDF (bìa, trang La Mã...).
# BOOK_TOC_PAGE_TOLERANCE=50
# Mỗi chương tốn ít nhất một lần gọi DeepSeek: số chương tối đa mỗi sách (phần dư
# được gộp vào chương cuối, không bỏ nội dung) và số trang mỗi phần khi sách không
# có mục lục lẫn tiêu đề chương.
# MAX_BOOK_CHAPTERS=40
# BOOK_FALLBACK_CHAPTER_PAGES=20
# Job chạy ngầm giữ kết quả trong RAM của process: thời gian sống (giây) và số job
# tối đa; `true` = trả 202 + job_id rồi xử lý ngầm (tránh timeout Render), client
# gửi `background=false` để nhận thẳng mảng kết quả.
# BOOK_JOB_TTL_SECONDS=86400
# MAX_BOOK_JOBS=25
# BOOK_BACKGROUND_BY_DEFAULT=true
# CORS: mặc định "*" = cho phép TẤT CẢ origin (frontend trên Vercel gọi được API ngay).
# Chỉ đặt biến dưới đây khi muốn giới hạn lại danh sách domain cụ thể (phân tách bằng dấu phẩy).
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# Regex cho domain Vercel (production + preview deployment). Mặc định đã bật để
# frontend trên Vercel gọi được API kể cả khi CORS_ALLOW_ORIGINS đã bị siết lại.
# Đặt chuỗi rỗng để tắt.
# CORS_ALLOW_ORIGIN_REGEX=https://([a-z0-9-]+\.)*vercel\.app
# HOST=127.0.0.1
# PORT=8000
